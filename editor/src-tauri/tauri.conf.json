{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EqPress",
  "version": "0.1.1",
  "identifier": "io.github.viniciusrfc.eqpress",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "EqPress",
        "width": 900,
        "height": 580,
        "minWidth": 680,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "eqpress"
        ]
      }
    }
  }
}
